{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    // Pinned explicitly: the URL global used by url() resolves from
    // @types/node, and default @types auto-inclusion does not provide it
    // as a value in this toolchain.
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true
  },
  "include": ["src", "test", "examples", "tsup.config.ts"]
}
